{
  "name": "techet-pay-desktop",
  "version": "1.0.0",
  "description": "TechET Pay desktop app (merchant dashboard and admin panel)",
  "main": "main.js",
  "private": true,
  "author": "TechET",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "et.techet.pay.desktop",
    "productName": "TechET Pay",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "config.json", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
